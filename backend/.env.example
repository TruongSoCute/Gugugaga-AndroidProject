# Sao chép thành .env để chạy trên máy cá nhân. KHÔNG commit file .env.
# Trên Render, khai báo các biến này trong mục Environment của service.

PORT=3000

# Supabase: Project Settings -> Database -> Connection string -> Session pooler (cổng 5432).
# Thay [PASSWORD] bằng mật khẩu CSDL. Trên máy cá nhân có thể dùng PostgreSQL cục bộ.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# true với Supabase; false với PostgreSQL cục bộ không bật SSL.
DATABASE_SSL=true
# Tùy chọn: nội dung chứng chỉ CA của Supabase (PEM) để kiểm tra máy chủ khi bật SSL.
DATABASE_CA_CERT=
DATABASE_POOL_MAX=5

# Chuỗi ngẫu nhiên >= 32 ký tự, tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Địa chỉ công khai của backend trên Render, dùng làm nội dung QR (không có dấu / cuối).
PUBLIC_BASE_URL=https://ten-service.onrender.com

# Dùng khi làm chức năng upload ảnh lên Supabase Storage (chưa triển khai).
# Khóa service role CHỈ đặt ở backend, không bao giờ đưa vào app di động.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Chỉ dùng cho kiểm thử tự động: CSDL riêng, sẽ bị XÓA và tạo lại mỗi lần chạy test.
TEST_DATABASE_URL=
