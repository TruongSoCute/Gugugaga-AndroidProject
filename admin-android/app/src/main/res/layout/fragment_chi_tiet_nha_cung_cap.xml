<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nen_man_hinh">

    <ScrollView
        android:id="@+id/noiDung"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/khoang_md">

            <!-- Thẻ tiêu đề và ảnh cơ sở -->
            <com.google.android.material.card.MaterialCardView
                style="@style/TheChiTiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivAnhCoSo"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/anh_lon"
                        android:background="@color/nen_nhap"
                        android:contentDescription="@string/mo_ta_anh_co_so"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/khoang_md">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvTen"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textAppearance="?attr/textAppearanceTitleLarge"
                                android:textColor="@color/chu_chinh"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTrangThai"
                                style="@style/NhanTrangThai"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/khoang_sm" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTuGui"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/khoang_sm"
                            android:background="@drawable/nen_ma_lo"
                            android:backgroundTint="@color/xanh_duong_nen"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="@string/ncc_tu_gui"
                            android:textColor="@color/xanh_duong_chu"
                            android:textSize="@dimen/chu_nho"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvLyDo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/khoang_sm"
                            android:background="@drawable/nen_ma_lo"
                            android:backgroundTint="@color/nen_tu_choi"
                            android:paddingStart="10dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="6dp"
                            android:textColor="@color/do_tu_choi"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TieuDeMuc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/muc_thong_tin_co_so" />

            <com.google.android.material.card.MaterialCardView
                style="@style/TheChiTiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/khoang_md">

                    <TextView
                        android:id="@+id/tvDaiDien"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/chu_chinh"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSdt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:textColor="@color/xanh_ocop"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDiaChi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/chu_chinh" />

                    <TextView
                        android:id="@+id/tvVung"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/khoang_xs"
                        android:textColor="@color/xanh_ocop"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTaoLuc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/khoang_sm"
                        android:textColor="@color/chu_phu"
                        android:textSize="@dimen/chu_nho" />

                    <TextView
                        android:id="@+id/tvDuyet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/chu_phu"
                        android:textSize="@dimen/chu_nho" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TieuDeMuc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/muc_chung_nhan" />

            <com.google.android.material.card.MaterialCardView
                style="@style/TheChiTiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/khoang_md">

                    <TextView
                        android:id="@+id/tvKhongCoChungNhan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/khong_co_chung_nhan"
                        android:textColor="@color/chu_phu"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/dsChungNhan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvChiXem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/khoang_md"
                android:background="@drawable/nen_ma_lo"
                android:backgroundTint="@color/nen_cho_duyet"
                android:padding="@dimen/khoang_sm_md"
                android:text="@string/nhan_vien_chi_xem_ho_so"
                android:textColor="@color/vang_cho_duyet"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/hangNut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/khoang_md"
                android:layout_marginBottom="@dimen/khoang_lg"
                android:gravity="end"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTuChoi"
                    style="@style/NutVienOcop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/nut_tu_choi"
                    android:textColor="@color/do_tu_choi" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDuyet"
                    style="@style/NutChinhOcop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/khoang_sm_md"
                    android:layout_weight="1"
                    android:text="@string/nut_duyet" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/khung_trang_thai" />
</FrameLayout>
