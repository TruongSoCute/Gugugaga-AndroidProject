<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nen_man_hinh">

    <ScrollView
        android:id="@+id/noiDung"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/khoang_md">

            <com.google.android.material.card.MaterialCardView
                style="@style/TheChiTiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/khoang_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvLoai"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceTitleLarge"
                            android:textColor="@color/chu_chinh"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTrangThai"
                            style="@style/NhanTrangThai"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/khoang_sm" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSanPham"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/khoang_sm_md"
                        android:textColor="@color/chu_chinh"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNhaCungCap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/chu_phu" />

                    <TextView
                        android:id="@+id/tvLo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/khoang_sm"
                        android:background="@drawable/nen_ma_lo"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:textColor="@color/xanh_ocop"
                        android:textIsSelectable="true"
                        android:textSize="@dimen/chu_nho" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TieuDeMuc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/muc_noi_dung_phan_anh" />

            <com.google.android.material.card.MaterialCardView
                style="@style/TheChiTiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/khoang_md">

                    <TextView
                        android:id="@+id/tvNoiDung"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/chu_chinh" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivAnh"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/anh_lon"
                        android:layout_marginTop="@dimen/khoang_sm_md"
                        android:background="@color/nen_nhap"
                        android:contentDescription="@string/mo_ta_anh_phan_anh"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/HinhAnhBoGoc" />

                    <TextView
                        android:id="@+id/tvNguoiBao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/khoang_sm_md"
                        android:textColor="@color/chu_phu"
                        android:textIsSelectable="true"
                        android:textSize="@dimen/chu_nho" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TieuDeMuc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/muc_xu_ly_phan_anh" />

            <TextView
                android:id="@+id/tvKetQua"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/nen_ma_lo"
                android:padding="@dimen/khoang_sm_md"
                android:textColor="@color/xanh_ocop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvKhongConBuoc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/khoang_xs"
                android:text="@string/phan_anh_da_dong"
                android:textColor="@color/chu_phu"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/hangNut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/khoang_sm"
                android:layout_marginBottom="@dimen/khoang_lg"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/khung_trang_thai" />
</FrameLayout>
