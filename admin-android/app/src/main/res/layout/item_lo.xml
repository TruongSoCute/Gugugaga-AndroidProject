<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ lô gọn: Tên SP + tồn / 2 tag (mã lô + số bước) trên 1 hàng / NSX · HSD · vùng. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/TheDong"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/khoang_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTenSanPham"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/chu_chinh"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/nen_nhan_trang_thai"
                android:backgroundTint="@color/nen_nhap"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textColor="@color/chu_chinh"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2 tag (Mã truy xuất + Số bước) trên đúng 1 hàng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMaTruyXuat"
                style="@style/MaTruyXuat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/nen_ma_lo"
                android:backgroundTint="@color/xanh_ocop_nhat"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textColor="@color/xanh_ocop"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/tvSoBuoc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/nen_nhan_trang_thai"
                android:backgroundTint="@color/nen_nhap"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textColor="@color/chu_phu"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvNgay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/chu_phu"
            android:textSize="@dimen/chu_nho" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
