<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/TheDong"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:orientation="vertical"
        android:padding="@dimen/khoang_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:id="@+id/tvTrangThai"
                style="@style/NhanTrangThai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/khoang_sm" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvVung"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/khoang_xs"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvTuGui"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/khoang_xs"
            android:text="@string/ncc_tu_gui"
            android:textColor="@color/xanh_duong_chu"
            android:textSize="@dimen/chu_nho"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvLyDo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/khoang_xs"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/do_tu_choi"
            android:textSize="@dimen/chu_nho"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
