<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/noiDung"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/khoang_md">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nhan_ncc_bat_buoc"
                android:textSize="@dimen/chu_nho" />

            <Spinner
                android:id="@+id/spNhaCungCap"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/khoang_xs"
                android:background="@drawable/khung_spinner" />

            <TextView
                android:id="@+id/tvLoiNcc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorError"
                android:textSize="@dimen/chu_nho"
                android:visibility="gone" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/khoang_sm"
                android:hint="@string/hint_ten_sp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtTen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilGia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/khoang_sm"
                android:hint="@string/hint_gia_ban">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtGia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDonViTinh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/khoang_sm"
                android:hint="@string/hint_don_vi_tinh">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtDonViTinh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilMoTa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/khoang_sm"
                android:hint="@string/hint_mo_ta_sp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtMoTa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAnh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/khoang_sm"
                android:hint="@string/hint_anh_sp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtAnh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/khoang_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnChonAnh"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nut_chon_anh" />

                <ProgressBar
                    android:id="@+id/progressAnh"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="@dimen/khoang_sm"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivAnh"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="@dimen/khoang_xs"
                android:contentDescription="@string/hint_anh_sp"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnLuu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/khoang_lg"
                android:text="@string/nut_luu" />

            <ProgressBar
                android:id="@+id/progressLuu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/khoang_sm"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/khung_trang_thai" />
</FrameLayout>
