<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ hồ sơ NCC tinh gọn: gom 2 tag (trạng thái + nguồn gửi) trên 1 hàng. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/TheDong"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/khoang_md">

        <TextView
            android:id="@+id/tvTen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/chu_chinh"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVung"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/chu_phu"
            android:textSize="@dimen/chu_nho" />

        <!-- 2 tag (Trạng thái + App Client) nằm cạnh nhau trên 1 hàng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/khoang_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTrangThai"
                style="@style/StatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvTuGui"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_status_badge"
                android:backgroundTint="@color/xanh_duong_nen"
                android:paddingStart="9dp"
                android:paddingTop="4dp"
                android:paddingEnd="9dp"
                android:paddingBottom="4dp"
                android:text="@string/ncc_tu_gui"
                android:textColor="@color/xanh_duong_chu"
                android:textSize="@dimen/chu_nho"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLyDo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/khoang_sm"
            android:background="@drawable/bg_batch_code"
            android:backgroundTint="@color/nen_tu_choi"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textColor="@color/do_tu_choi"
            android:textSize="@dimen/chu_nho"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
