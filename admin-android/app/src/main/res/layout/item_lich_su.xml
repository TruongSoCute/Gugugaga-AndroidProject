<?xml version="1.0" encoding="utf-8"?>
<!-- Một lần chuyển trạng thái của đơn dạng mốc timeline. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="@dimen/khoang_xs"
    android:paddingBottom="@dimen/khoang_sm">

    <View
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/nen_thu_tu" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/khoang_sm_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTrangThaiLichSu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/chu_chinh"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvThoiDiemLichSu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/chu_phu"
            android:textSize="@dimen/chu_nho" />

        <TextView
            android:id="@+id/tvGhiChuLichSu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/chu_phu"
            android:textSize="@dimen/chu_nho"
            android:textStyle="italic" />
    </LinearLayout>
</LinearLayout>
