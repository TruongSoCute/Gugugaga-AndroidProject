
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/khoang_md"
        android:layout_marginTop="@dimen/khoang_sm"
        android:layout_marginEnd="@dimen/khoang_md"
        android:text="@string/loc_trang_thai"
        android:textSize="@dimen/chu_nho" />

    <Spinner
        android:id="@+id/spLoc"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/khoang_sm"
        android:layout_marginEnd="@dimen/khoang_sm" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSanPham"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/khoang_md" />

        <!-- Loading toàn màn hình -->
        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Loading khi tải trang tiếp theo -->
        <ProgressBar
            android:id="@+id/progressTaiThem"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="@dimen/khoang_md"
            android:visibility="gone" />

        <!-- Danh sách trống -->
        <TextView
            android:id="@+id/tvTrong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/khoang_lg"
            android:text="@string/danh_sach_trong"
            android:visibility="gone" />

        <!-- Hiển thị lỗi tải danh sách -->
        <LinearLayout
            android:id="@+id/khungLoi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/khoang_lg"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvLoi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="?attr/colorError" />

            <Button
                android:id="@+id/btnThuLai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/khoang_sm"
                android:text="@string/nut_thu_lai" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
