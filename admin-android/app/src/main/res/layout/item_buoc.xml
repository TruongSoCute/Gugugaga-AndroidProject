<?xml version="1.0" encoding="utf-8"?>
<!-- Một bước truy xuất: số thứ tự trong vòng tròn + tên, thời điểm, mô tả, ảnh. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingTop="@dimen/khoang_xs"
    android:paddingBottom="@dimen/khoang_xs">

    <TextView
        android:id="@+id/tvThuTu"
        android:layout_width="@dimen/vong_thu_tu"
        android:layout_height="@dimen/vong_thu_tu"
        android:layout_marginTop="@dimen/khoang_xs"
        android:background="@drawable/nen_thu_tu"
        android:gravity="center"
        android:textColor="@color/nen_icon"
        android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Material3.CardView.Outlined"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/khoang_sm"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/khoang_sm">

            <TextView
                android:id="@+id/tvTenBuoc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvThoiDiemBuoc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/xam_chu"
                android:textSize="@dimen/chu_nho" />

            <TextView
                android:id="@+id/tvMoTaBuoc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/khoang_xs" />

            <ImageView
                android:id="@+id/ivAnhBuoc"
                android:layout_width="match_parent"
                android:layout_height="@dimen/anh_lon"
                android:layout_marginTop="@dimen/khoang_sm"
                android:background="@color/xam_nen"
                android:contentDescription="@string/mo_ta_anh_buoc"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
