<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/noiDung"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/khoang_md">

            <!-- Thẻ QR: in lên bao bì; quét bằng camera mở đường dẫn truy xuất công khai. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/TheChiTiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/khoang_md">

                    <ImageView
                        android:id="@+id/ivQr"
                        android:layout_width="@dimen/kich_thuoc_qr"
                        android:layout_height="@dimen/kich_thuoc_qr"
                        android:background="@color/nen_icon"
                        android:contentDescription="@string/mo_ta_qr_chung" />

                    <TextView
                        android:id="@+id/tvMaTruyXuat"
                        style="@style/MaTruyXuat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/khoang_sm"
                        android:textIsSelectable="true"
                        android:textSize="@dimen/chu_ma" />

                    <TextView
                        android:id="@+id/tvDuongDan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textIsSelectable="true"
                        android:textSize="@dimen/chu_nho" />

                    <Button
                        android:id="@+id/btnChiaSe"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nut_chia_se" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/khoang_md"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTenSanPham"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:id="@+id/tvTrangThaiSanPham"
                    style="@style/NhanTrangThai"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/khoang_sm" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNgay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/khoang_xs" />

            <TextView
                android:id="@+id/tvSoLuong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvVung"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvNguoiSanXuat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvGhiChu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="italic" />

            <ImageView
                android:id="@+id/ivAnhHienTruong"
                android:layout_width="match_parent"
                android:layout_height="@dimen/anh_lon"
                android:layout_marginTop="@dimen/khoang_sm"
                android:background="@color/xam_nen"
                android:contentDescription="@string/mo_ta_anh_hien_truong"
                android:scaleType="centerCrop" />

            <TextView
                style="@style/TieuDeMuc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/muc_cac_buoc" />

            <TextView
                android:id="@+id/tvChuaCoBuoc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/chua_co_buoc"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/dsBuoc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btnThemBuoc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/khoang_sm"
                android:layout_marginBottom="@dimen/khoang_lg"
                android:text="@string/nut_them_buoc" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/khung_trang_thai" />
</FrameLayout>
