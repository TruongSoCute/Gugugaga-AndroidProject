<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nen_man_hinh">

    <ScrollView
        android:id="@+id/noiDung"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/khoang_md">

            <!-- Thẻ QR tinh gọn không viền thừa -->
            <com.google.android.material.card.MaterialCardView
                style="@style/TheChiTiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/bo_goc_lon">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/khoang_lg">

                    <ImageView
                        android:id="@+id/ivQr"
                        android:layout_width="@dimen/kich_thuoc_qr"
                        android:layout_height="@dimen/kich_thuoc_qr"
                        android:background="@color/nen_icon"
                        android:contentDescription="@string/mo_ta_qr_chung"
                        android:padding="@dimen/khoang_xs" />

                    <TextView
                        android:id="@+id/tvMaTruyXuat"
                        style="@style/MaTruyXuat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/khoang_md"
                        android:background="@drawable/nen_ma_lo"
                        android:paddingStart="14dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="6dp"
                        android:textColor="@color/chu_chinh"
                        android:textIsSelectable="true"
                        android:textSize="@dimen/chu_ma" />

                    <TextView
                        android:id="@+id/tvDuongDan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/khoang_sm"
                        android:gravity="center"
                        android:textColor="@color/chu_phu"
                        android:textIsSelectable="true"
                        android:textSize="@dimen/chu_nho" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChiaSe"
                        style="@style/NutPhuOcop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/khoang_md"
                        android:text="@string/nut_chia_se"
                        app:icon="@drawable/ic_chia_se"
                        app:iconSize="18dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/TheChiTiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/khoang_sm_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/khoang_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTenSanPham"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/chu_chinh"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTrangThaiSanPham"
                            style="@style/NhanTrangThai"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/khoang_sm" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvVung"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/khoang_sm"
                        android:textColor="@color/xanh_ocop"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNgay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/khoang_xs"
                        android:textColor="@color/chu_chinh" />

                    <TextView
                        android:id="@+id/tvSoLuong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/chu_chinh" />

                    <TextView
                        android:id="@+id/tvNguoiSanXuat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/chu_phu" />

                    <TextView
                        android:id="@+id/tvGhiChu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/khoang_xs"
                        android:textColor="@color/chu_phu"
                        android:textStyle="italic" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivAnhHienTruong"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/anh_lon"
                        android:layout_marginTop="@dimen/khoang_sm_md"
                        android:background="@color/nen_nhap"
                        android:contentDescription="@string/mo_ta_anh_hien_truong"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/HinhAnhBoGoc" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TieuDeMuc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/muc_cac_buoc" />

            <TextView
                android:id="@+id/tvChuaCoBuoc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/chua_co_buoc"
                android:textColor="@color/chu_phu"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/dsBuoc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnThemBuoc"
                style="@style/NutChinhOcop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/khoang_md"
                android:layout_marginBottom="@dimen/khoang_lg"
                android:text="@string/nut_them_buoc"
                app:icon="@drawable/ic_them"
                app:iconGravity="textStart" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/khung_trang_thai" />
</FrameLayout>
