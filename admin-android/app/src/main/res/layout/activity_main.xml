<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nen_man_hinh"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/nen_man_hinh"
        app:title="@string/app_name"
        app:titleTextColor="@color/chu_chinh" />

    <!-- Khung chứa Fragment: dùng FragmentContainerView, không dùng FrameLayout (Lab A8). -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Thanh điều hướng nổi dạng viên thuốc (Floating Capsule Dock) bọc BottomNavigationView chuẩn Lab A8 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/khoang_dock_ngang"
        android:layout_marginTop="@dimen/khoang_xs"
        android:layout_marginEnd="@dimen/khoang_dock_ngang"
        android:layout_marginBottom="@dimen/khoang_dock_duoi"
        app:cardBackgroundColor="@color/nen_dock"
        app:cardCornerRadius="@dimen/bo_goc_dock"
        app:cardElevation="@dimen/cao_bong_dock"
        app:strokeWidth="0dp">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            style="@style/ThanhDieuHuongDuoiOcop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:menu="@menu/bottom_nav" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
