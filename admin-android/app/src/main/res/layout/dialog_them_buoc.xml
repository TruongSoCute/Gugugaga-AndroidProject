<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/khoang_lg"
        android:paddingTop="@dimen/khoang_sm"
        android:paddingEnd="@dimen/khoang_lg">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTenBuoc"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_ten_buoc">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtTenBuoc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLength="120" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Không cho gõ tay: bấm vào để mở DatePickerDialog rồi TimePickerDialog. -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilThoiDiem"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/khoang_sm"
            android:hint="@string/hint_thoi_diem">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtThoiDiem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:cursorVisible="false"
                android:focusable="false"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMoTa"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/khoang_sm"
            android:hint="@string/hint_mo_ta_buoc">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtMoTa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="2000"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAnhUrl"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/khoang_sm"
            android:hint="@string/hint_anh_url">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtAnhUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/khoang_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnChonAnhBuoc"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nut_chon_anh" />

            <ProgressBar
                android:id="@+id/progressTaiAnhBuoc"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/khoang_sm"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTrangThaiAnhBuoc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/khoang_sm"
                android:layout_weight="1"
                android:textSize="@dimen/chu_nho"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivXemTruocAnhBuoc"
            android:layout_width="match_parent"
            android:layout_height="@dimen/anh_lon"
            android:layout_marginTop="@dimen/khoang_sm"
            android:background="@color/xam_nen"
            android:contentDescription="@string/mo_ta_anh_buoc"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
