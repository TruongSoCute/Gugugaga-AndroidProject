<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nen_man_hinh"
    android:orientation="vertical">

    <!-- Thanh lọc khoảng ngày tối giản trên cùng nền -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/khoang_md"
        android:paddingTop="@dimen/khoang_xs"
        android:paddingEnd="@dimen/khoang_sm"
        android:paddingBottom="@dimen/khoang_sm">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTuNgay"
            style="@style/NutVienOcop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textSize="@dimen/chu_nho"
            app:backgroundTint="@color/nen_the"
            app:icon="@drawable/ic_calendar"
            app:iconSize="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDenNgay"
            style="@style/NutVienOcop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/khoang_sm"
            android:layout_weight="1"
            android:maxLines="1"
            android:textSize="@dimen/chu_nho"
            app:backgroundTint="@color/nen_the"
            app:icon="@drawable/ic_calendar"
            app:iconSize="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnXoaLoc"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nut_xoa_loc"
            android:textColor="@color/chu_phu"
            android:textSize="@dimen/chu_nho" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLoiLoc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/khoang_md"
        android:layout_marginEnd="@dimen/khoang_md"
        android:text="@string/loi_tu_sau_den"
        android:textColor="?attr/colorError"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/noiDung"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/khoang_md">

                <!-- Thẻ KPI tối giản nền tối sắc nét kiểu 21st / Linear -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero_gradient"
                    android:orientation="vertical"
                    android:padding="@dimen/khoang_lg">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tong_doanh_so"
                        android:textColor="@color/chu_phu_tren_hero"
                        android:textSize="@dimen/chu_phu" />

                    <TextView
                        android:id="@+id/tvTongDoanhSo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/chu_tren_hero"
                        android:textSize="@dimen/chu_kpi"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/khoang_sm_md"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTongDon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_kpi_chip"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:textColor="@color/chu_tren_hero"
                            android:textSize="@dimen/chu_nho"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTongSanPham"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_kpi_chip"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:textColor="@color/chu_phu_tren_hero"
                            android:textSize="@dimen/chu_nho"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    style="@style/TheChiTiet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/khoang_sm_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/khoang_md">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/muc_theo_vung"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/chu_chinh"
                            android:textStyle="bold" />

                        <vn.edu.vhu.ltdd.gugugaga.admin.ui.sales.BarChartView
                            android:id="@+id/bdVung"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/khoang_sm" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/TheChiTiet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/khoang_sm_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/khoang_md">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/muc_theo_hang_sao"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/chu_chinh"
                            android:textStyle="bold" />

                        <vn.edu.vhu.ltdd.gugugaga.admin.ui.sales.BarChartView
                            android:id="@+id/bdHangSao"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/khoang_sm" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/TheChiTiet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/khoang_sm_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/khoang_md">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/muc_ncc_ban_chay"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/chu_chinh"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTrongTop"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/khoang_sm"
                            android:text="@string/chua_co_doanh_so"
                            android:textColor="@color/chu_phu"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/dsTop"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/khoang_sm"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/khoang_md"
                    android:layout_marginBottom="@dimen/khoang_lg"
                    android:text="@string/ghi_chu_bao_cao"
                    android:textColor="@color/chu_phu"
                    android:textSize="@dimen/chu_nho" />
            </LinearLayout>
        </ScrollView>

        <include layout="@layout/panel_state" />
    </FrameLayout>
</LinearLayout>
