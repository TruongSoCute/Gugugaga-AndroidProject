<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ sản phẩm trực quan: ảnh bo góc bên trái + giá và 2 tag (hạng sao + trạng thái) trên 1 hàng. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/TheDong"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/khoang_sm_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivAnh"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@color/nen_nhap"
                android:contentDescription="@string/mo_ta_anh_sp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/HinhAnhBoGoc" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/khoang_sm_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/chu_chinh"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNhaCungCap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/chu_phu"
                    android:textSize="@dimen/chu_nho" />

                <!-- Giá bên trái + 2 tag (★ sao + trạng thái) gọn trên đúng 1 hàng -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/khoang_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvGia"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="@color/chu_chinh"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHangSao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/nen_nhan_trang_thai"
                        android:backgroundTint="@color/vang_ocop_nhat"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:textColor="@color/vang_cho_duyet"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTrangThai"
                        style="@style/NhanTrangThai"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvNccChuaDuyet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/khoang_sm"
            android:text="@string/ncc_chua_duyet"
            android:textColor="@color/vang_cho_duyet"
            android:textSize="@dimen/chu_nho"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvLyDo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/khoang_xs"
            android:textColor="@color/do_tu_choi"
            android:textSize="@dimen/chu_nho"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/hangNut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/khoang_sm_md"
            android:gravity="end"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTuChoi"
                style="@style/NutVienOcop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:text="@string/nut_tu_choi"
                android:textColor="@color/do_tu_choi" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDuyet"
                style="@style/NutChinhOcop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/khoang_sm"
                android:minHeight="40dp"
                android:text="@string/nut_duyet" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
